# ======================
# WEATHER (OpenWeather)
# ======================
OWM_API_KEY=your_openweather_api_key

LOCATION_LAT=46.947975
LOCATION_LON=7.447447
RAIN_CHECK_HOURS=12

# ======================
# STOCK & NEWS
# ======================
STOCK_API_KEY=your_alpha_vantage_api_key
NEWS_API_KEY=your_newsapi_key

STOCK_SYMBOL=TSLA
COMPANY_NAME=Tesla Inc
STOCK_PERCENT_THRESHOLD=5

# ======================
# TWILIO SMS
# ======================
TWILIO_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
VIRTUAL_TWILIO_NUMBER=+15017122661
VERIFIED_NUMBER=+2519XXXXXXXX

# ======================
# APP SETTINGS
# ======================
REQUEST_TIMEOUT=10
MAX_RETRIES=3
